# Copy to .env and fill in real values. Every setting here has a safe
# default in settings.py if left unset — nothing in this file is
# required to run the app locally with SQLite + eager Celery tasks.

# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-character-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (leave unset for local SQLite) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nsaabodee
DB_USER=nsaabodee
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- Celery / Redis (leave CELERY_TASK_ALWAYS_EAGER=True for local dev) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
CHANNEL_LAYERS_REDIS_URL=redis://localhost:6379/1

# --- Email (Communication Module) ---
DEFAULT_FROM_EMAIL=no-reply@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- WhatsApp (Meta Business Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- MTN MoMo (Collections API) ---
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
